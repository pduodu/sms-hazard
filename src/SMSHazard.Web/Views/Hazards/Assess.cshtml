@model SMSHazard.Web.Models.Hazards.AssessViewModel
@{
    ViewData["Title"] = Model.IsResidual ? "Residual risk re-assessment" : "Risk assessment";
}

<h2 class="text-xl font-semibold text-slate-900">@ViewData["Title"]</h2>
<p class="text-slate-500 mb-4">@Model.ReferenceNo - @Model.Title</p>

<div class="card max-w-3xl">
    <div class="card-body">
        <partial name="_AssessForm" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
