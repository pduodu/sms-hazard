@model SMSHazard.Web.Models.Hazards.HazardListViewModel
@{
    ViewData["Title"] = Model.Heading;
}
<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold text-slate-900">@Model.Heading</h2>
    <a class="btn-primary" asp-action="Create">+ Report hazard</a>
</div>

@if (Model.ShowFilters)
{
    <form method="get" asp-action="Index" class="flex flex-wrap gap-2 mb-4">
        <select name="Status" class="select btn-sm !w-auto" asp-items="Html.GetEnumSelectList<HazardStatus>()">
            <option value="">All statuses</option>
        </select>
        <select name="RiskLevel" class="select btn-sm !w-auto" asp-items="Html.GetEnumSelectList<RiskLevel>()">
            <option value="">All risk levels</option>
        </select>
        <select name="DepartmentId" class="select btn-sm !w-auto" asp-items="Model.Departments">
            <option value="">All departments</option>
        </select>
        <button type="submit" class="btn-outline btn-sm">Filter</button>
        <a class="btn-outline btn-sm" asp-action="Index">Reset</a>
    </form>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-muted">No hazards found.</div>
}
else
{
    <div class="card"><div class="card-body overflow-x-auto">
        <table class="table table-hover" data-datatable>
            <thead>
                <tr>
                    <th>Ref</th><th>Title</th><th>Category</th><th>Department</th>
                    <th>Risk</th><th>Status</th><th>Reported</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var h in Model.Items)
            {
                <tr class="clickable-row" data-row-href="@Url.Action("Details", "Hazards", new { id = h.Id })">
                    <td class="whitespace-nowrap"><a asp-action="Details" asp-route-id="@h.Id">@h.ReferenceNo</a></td>
                    <td>@h.Title</td>
                    <td>@h.CategoryName</td>
                    <td>@h.DepartmentName</td>
                    <td>
                        @if (h.CurrentRiskLevel is not null)
                        {
                            <span class="badge @HazardDisplay.RiskCss(h.CurrentRiskLevel)">@h.CurrentRiskLevel (@h.CurrentRiskScore)</span>
                        }
                        else
                        {
                            <span class="text-slate-400 text-xs">not assessed</span>
                        }
                    </td>
                    <td><span class="badge @HazardDisplay.StatusCss(h.Status)">@HazardDisplay.StatusText(h.Status)</span></td>
                    <td class="whitespace-nowrap">@h.ReportedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (h.OverdueCount > 0)
                        {
                            <span class="badge badge-red" title="Overdue corrective actions">@h.OverdueCount overdue</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
