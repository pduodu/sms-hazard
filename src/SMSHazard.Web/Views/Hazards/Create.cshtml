@model SMSHazard.Web.Models.Hazards.CreateHazardViewModel
@{
    ViewData["Title"] = "Report a hazard";
}
<div class="card max-w-3xl"><div class="card-body">
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
            <label asp-for="Title" class="label"></label>
            <input asp-for="Title" class="input" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>
        <div>
            <label asp-for="OccurrenceDate" class="label"></label>
            <input asp-for="OccurrenceDate" type="date" class="input" />
            <span asp-validation-for="OccurrenceDate" class="field-error"></span>
        </div>
        <div>
            <label asp-for="HazardCategoryId" class="label"></label>
            <select asp-for="HazardCategoryId" asp-items="Model.Categories" class="select">
                <option value="">— select category —</option>
            </select>
            <span asp-validation-for="HazardCategoryId" class="field-error"></span>
        </div>
        <div>
            <label asp-for="DepartmentId" class="label"></label>
            <select asp-for="DepartmentId" asp-items="Model.Departments" class="select">
                <option value="">— select department —</option>
            </select>
            <span asp-validation-for="DepartmentId" class="field-error"></span>
        </div>
        <div class="sm:col-span-2">
            <label asp-for="Description" class="label"></label>
            <textarea asp-for="Description" class="textarea" rows="4"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>
        <div class="sm:col-span-2">
            <label asp-for="ImmediateActionTaken" class="label"></label>
            <textarea asp-for="ImmediateActionTaken" class="textarea" rows="2"></textarea>
            <span asp-validation-for="ImmediateActionTaken" class="field-error"></span>
        </div>
        <div class="sm:col-span-2">
            <label asp-for="Attachments" class="label"></label>
            <input asp-for="Attachments" type="file" class="input" multiple accept="image/*,application/pdf" />
            <div class="text-slate-500 text-xs mt-1">Images or PDF, up to 25 MB each.</div>
            <partial name="_CameraCapture" model="@("Attachments")" />
            <span asp-validation-for="Attachments" class="field-error"></span>
        </div>
    </div>
    <div class="mt-4 flex gap-2">
        <button type="submit" class="btn-primary">Submit hazard</button>
        <a class="btn-outline" asp-action="MyReports">Cancel</a>
    </div>
</form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
