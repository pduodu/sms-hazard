@{
    ViewData["Title"] = "Password reset";
    Layout = "_AuthLayout";
}
<div class="text-center">
    <i data-lucide="circle-check-big" class="text-4xl text-emerald-500"></i>
    <h4 class="text-lg font-semibold text-slate-900 mt-2">Password reset</h4>
    <p class="text-sm text-slate-600 mt-1">Your password has been updated. You can now sign in with your new password.</p>
    <a class="btn-primary mt-4" asp-action="Login">Go to sign in</a>
</div>
