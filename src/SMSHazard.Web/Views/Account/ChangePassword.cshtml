@model SMSHazard.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="card max-w-md"><div class="card-body">
    <form asp-action="ChangePassword" method="post" class="space-y-4">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div>
            <label asp-for="CurrentPassword" class="label"></label>
            <input asp-for="CurrentPassword" class="input" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div>
            <label asp-for="NewPassword" class="label"></label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="label"></label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn-primary">Update password</button>
            <a class="btn-outline" asp-action="Profile">Cancel</a>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
