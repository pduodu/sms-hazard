@model SMSHazard.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}
<h4 class="text-lg font-semibold text-slate-900 mb-4">Choose a new password</h4>
<form asp-action="ResetPassword" method="post" class="space-y-4">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Code" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div>
        <label asp-for="NewPassword" class="label"></label>
        <input asp-for="NewPassword" class="input" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="label"></label>
        <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <button type="submit" class="btn-primary w-full">Reset password</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
