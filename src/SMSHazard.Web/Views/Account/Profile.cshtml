@model SMSHazard.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
<h2 class="mb-3">My profile</h2>
<div class="card" style="max-width:520px"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-4">Name</dt><dd class="col-8">@Model.FullName</dd>
        <dt class="col-4">Email</dt><dd class="col-8">@Model.Email</dd>
        <dt class="col-4">Role(s)</dt><dd class="col-8">@Model.Roles</dd>
    </dl>
</div></div>
<a class="btn btn-outline-primary mt-3" asp-action="ChangePassword">Change password</a>
