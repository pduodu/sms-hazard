@model SMSHazard.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}
<div class="card max-w-lg"><div class="card-body">
    <dl class="divide-y divide-slate-100">
        <div class="dl-row"><dt>Name</dt><dd>@Model.FullName</dd></div>
        <div class="dl-row"><dt>Email</dt><dd>@Model.Email</dd></div>
        <div class="dl-row"><dt>Role(s)</dt><dd>@Model.Roles</dd></div>
    </dl>
</div></div>
<div class="flex flex-wrap gap-2 mt-4">
    <a class="btn-outline-primary" asp-action="ChangePassword">Change password</a>
    <a class="btn-outline" asp-action="TwoFactor"><i data-lucide="shield-check"></i> Two-factor authentication</a>
</div>
