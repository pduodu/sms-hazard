@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}
<div class="text-center">
    <i data-lucide="mail-check" class="text-4xl text-emerald-500"></i>
    <h4 class="text-lg font-semibold text-slate-900 mt-2">Check your email</h4>
    <p class="text-sm text-slate-600 mt-1">If an account exists for that address, we've sent a link to reset your password. The link expires after a short while.</p>
    <a class="btn-outline mt-4" asp-action="Login">Back to sign in</a>
</div>
