@model SMSHazard.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}
<h4 class="text-lg font-semibold text-slate-900 mb-2">Forgot your password?</h4>
<p class="text-sm text-slate-500 mb-4">Enter your email and we'll send you a link to reset it.</p>
<form asp-action="ForgotPassword" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div>
        <label asp-for="Email" class="label"></label>
        <input asp-for="Email" class="input" autocomplete="username" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <button type="submit" class="btn-primary w-full">Send reset link</button>
</form>
<div class="text-center mt-4">
    <a class="text-sm" asp-action="Login">Back to sign in</a>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
