<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SMS-Hazard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom mb-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🛡️ SMS-Hazard</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                    aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Hazards" asp-action="Create">Report hazard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Hazards" asp-action="MyReports">My reports</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Capa" asp-action="MyActions">My actions</a></li>
                        @if (User.IsInRole("SafetyOfficer") || User.IsInRole("Manager") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Hazards" asp-action="Index">Register</a></li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit</a></li>
                            <li class="nav-item"><a class="nav-link" href="/hangfire">Reminders</a></li>
                        }
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">@await Component.InvokeAsync("NotificationBell")</li>
                        var role = User.IsInRole("Admin") ? "Admin"
                            : User.IsInRole("Manager") ? "Manager"
                            : User.IsInRole("SafetyOfficer") ? "Safety Officer"
                            : User.IsInRole("Reporter") ? "Reporter" : "User";
                        <li class="nav-item d-flex align-items-center text-light me-2">
                            <span class="me-2">@User.Identity!.Name</span>
                            <span class="badge bg-info text-dark">@role</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>
<footer class="border-top footer text-muted">
    <div class="container">&copy; 2026 SMS-Hazard — CSCD602 Capstone (22427657)</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    <script>
        // MVP in-app notifications: poll the unread count and update the bell badge.
        (function () {
            var badge = document.getElementById('notif-badge');
            if (!badge) return;
            async function poll() {
                try {
                    var r = await fetch('/Notifications/UnreadCount', { headers: { 'Accept': 'application/json' } });
                    if (!r.ok) return;
                    var d = await r.json();
                    if (d.count > 0) { badge.textContent = d.count; badge.classList.remove('d-none'); }
                    else { badge.classList.add('d-none'); }
                } catch (e) { /* ignore transient errors */ }
            }
            setInterval(poll, 30000);
        })();
    </script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
