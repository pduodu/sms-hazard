@model SMSHazard.Web.Models.Config.EditLookupViewModel
@{
    ViewData["Title"] = "Rename";
}
<h2 class="text-xl font-semibold text-slate-900 mb-4">Rename @Model.Kind.ToLower()</h2>
<div class="card max-w-md"><div class="card-body">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Kind" />
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div class="mb-4">
        <label asp-for="Name" class="label"></label>
        <input asp-for="Name" class="input" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn-primary">Save</button>
        <a class="btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
