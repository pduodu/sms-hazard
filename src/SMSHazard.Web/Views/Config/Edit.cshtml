@model SMSHazard.Web.Models.Config.EditLookupViewModel
@{
    ViewData["Title"] = "Rename";
}
<h2 class="mb-3">Rename @Model.Kind.ToLower()</h2>
<form asp-action="Edit" method="post" style="max-width:480px">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Kind" />
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
