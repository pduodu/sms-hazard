@model IReadOnlyList<SMSHazard.Application.DTOs.AuditLogDto>
@{
    ViewData["Title"] = "Audit log";
    var entity = ViewBag.Entity as string;
}
<h2 class="text-xl font-semibold text-slate-900 mb-4">Audit log</h2>

<form method="get" class="flex flex-wrap gap-2 mb-4">
    <select name="entity" class="select btn-sm !w-auto">
        <option value="">All entities</option>
        <option value="HazardReport" selected="@(entity == "HazardReport")">Hazard reports</option>
        <option value="RiskAssessment" selected="@(entity == "RiskAssessment")">Risk assessments</option>
        <option value="CorrectiveAction" selected="@(entity == "CorrectiveAction")">Corrective actions</option>
    </select>
    <button type="submit" class="btn-outline btn-sm">Filter</button>
    <a class="btn-outline btn-sm" asp-action="Index">Reset</a>
</form>

@if (!Model.Any())
{
    <div class="alert alert-muted">No audit entries.</div>
}
else
{
    <div class="card"><div class="card-body overflow-x-auto">
        <table class="table table-hover" data-datatable>
            <thead>
                <tr><th>When</th><th>Entity</th><th>Id</th><th>Action</th><th>By</th><th>Change</th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="whitespace-nowrap">@a.Timestamp.ToString("dd MMM yyyy HH:mm:ss")</td>
                    <td>@a.EntityName</td>
                    <td>@a.EntityId</td>
                    <td>
                        <span class="badge @(a.Action == "Created" ? "badge-green" : a.Action == "Deleted" ? "badge-red" : "badge-gray")">@a.Action</span>
                    </td>
                    <td>@a.ChangedByName</td>
                    <td class="text-xs">@a.ChangeSummary</td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
