@model SMSHazard.Web.Models.Capa.VerifyViewModel
@{
    ViewData["Title"] = "Verify & close";
}
<h2 class="mb-1">Verify &amp; close</h2>
<p class="text-muted">@Model.ReferenceNo — @Model.Title</p>
<p>Record the <strong>residual risk</strong> remaining after the corrective actions. Closure is permitted only when residual risk is <strong>Low or Medium</strong>; otherwise the hazard returns to Action Required for further mitigation.</p>

<form asp-action="Verify" method="post">
    <input type="hidden" asp-for="HazardId" />
    <input type="hidden" asp-for="ReferenceNo" />
    <input type="hidden" asp-for="Title" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Likelihood" class="form-label"></label>
            <select asp-for="Likelihood" id="likelihood" class="form-select">
                <option value="5">5 — Frequent</option>
                <option value="4">4 — Occasional</option>
                <option value="3">3 — Remote</option>
                <option value="2" selected>2 — Improbable</option>
                <option value="1">1 — Extremely Improbable</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Severity" class="form-label"></label>
            <select asp-for="Severity" id="severity" class="form-select">
                <option value="5">5 — Catastrophic</option>
                <option value="4">4 — Hazardous</option>
                <option value="3">3 — Major</option>
                <option value="2" selected>2 — Minor</option>
                <option value="1">1 — Negligible</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Residual risk</label>
            <div id="riskBox" class="p-2 rounded text-center fw-bold text-white"><span id="riskScore">4</span> — <span id="riskLevel">Low</span></div>
        </div>
        <div class="col-12">
            <label asp-for="EffectivenessNote" class="form-label"></label>
            <textarea asp-for="EffectivenessNote" class="form-control" rows="3"
                      placeholder="Were the actions effective? Any residual controls in place?"></textarea>
            <span asp-validation-for="EffectivenessNote" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-success">Verify &amp; close</button>
        <a class="btn btn-outline-secondary" asp-controller="Hazards" asp-action="Details" asp-route-id="@Model.HazardId">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function bandOf(s){ if(s<=4)return{n:'Low',c:'#198754'}; if(s<=9)return{n:'Medium',c:'#ffc107',d:true}; if(s<=15)return{n:'High',c:'#fd7e14'}; return{n:'Extreme',c:'#dc3545'}; }
        function upd(){
            var l=+document.getElementById('likelihood').value, s=+document.getElementById('severity').value, sc=l*s, b=bandOf(sc);
            document.getElementById('riskScore').textContent=sc;
            document.getElementById('riskLevel').textContent=b.n;
            var box=document.getElementById('riskBox'); box.style.backgroundColor=b.c; box.style.color=b.d?'#000':'#fff';
        }
        document.getElementById('likelihood').addEventListener('change',upd);
        document.getElementById('severity').addEventListener('change',upd);
        upd();
    </script>
}
