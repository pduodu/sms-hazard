@model SMSHazard.Web.Models.Capa.VerifyViewModel
@{
    ViewData["Title"] = "Verify & close";
}
<h2 class="text-xl font-semibold text-slate-900">Verify &amp; close</h2>
<p class="text-slate-500">@Model.ReferenceNo — @Model.Title</p>
<p class="text-slate-600 my-3 max-w-3xl">Record the <strong>residual risk</strong> remaining after the corrective actions. Closure is permitted only when residual risk is <strong>Low or Medium</strong>; otherwise the hazard returns to Action Required for further mitigation.</p>

<div class="card max-w-3xl"><div class="card-body">
<form asp-action="Verify" method="post">
    <input type="hidden" asp-for="HazardId" />
    <input type="hidden" asp-for="ReferenceNo" />
    <input type="hidden" asp-for="Title" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="grid gap-4 sm:grid-cols-3">
        <div>
            <label asp-for="Likelihood" class="label"></label>
            <select asp-for="Likelihood" id="likelihood" class="select">
                <option value="5">5 — Frequent</option>
                <option value="4">4 — Occasional</option>
                <option value="3">3 — Remote</option>
                <option value="2" selected>2 — Improbable</option>
                <option value="1">1 — Extremely Improbable</option>
            </select>
        </div>
        <div>
            <label asp-for="Severity" class="label"></label>
            <select asp-for="Severity" id="severity" class="select">
                <option value="5">5 — Catastrophic</option>
                <option value="4">4 — Hazardous</option>
                <option value="3">3 — Major</option>
                <option value="2" selected>2 — Minor</option>
                <option value="1">1 — Negligible</option>
            </select>
        </div>
        <div>
            <label class="label">Residual risk</label>
            <div id="riskBox" class="p-2 rounded-lg text-center font-bold text-white"><span id="riskScore">4</span> — <span id="riskLevel">Low</span></div>
        </div>
        <div class="sm:col-span-3">
            <label asp-for="EffectivenessNote" class="label"></label>
            <textarea asp-for="EffectivenessNote" class="textarea" rows="3"
                      placeholder="Were the actions effective? Any residual controls in place?"></textarea>
            <span asp-validation-for="EffectivenessNote" class="field-error"></span>
        </div>
    </div>
    <div class="mt-4 flex gap-2">
        <button type="submit" class="btn-success">Verify &amp; close</button>
        <a class="btn-outline" asp-controller="Hazards" asp-action="Details" asp-route-id="@Model.HazardId">Cancel</a>
    </div>
</form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function bandOf(s){ if(s<=4)return{n:'Low',c:'#198754'}; if(s<=9)return{n:'Medium',c:'#ffc107',d:true}; if(s<=15)return{n:'High',c:'#fd7e14'}; return{n:'Extreme',c:'#dc3545'}; }
        function upd(){
            var l=+document.getElementById('likelihood').value, s=+document.getElementById('severity').value, sc=l*s, b=bandOf(sc);
            document.getElementById('riskScore').textContent=sc;
            document.getElementById('riskLevel').textContent=b.n;
            var box=document.getElementById('riskBox'); box.style.backgroundColor=b.c; box.style.color=b.d?'#000':'#fff';
        }
        document.getElementById('likelihood').addEventListener('change',upd);
        document.getElementById('severity').addEventListener('change',upd);
        upd();
    </script>
}
