@model SMSHazard.Web.Models.Capa.CreateCapaViewModel
@{
    ViewData["Title"] = "Assign corrective action";
}
<h2 class="mb-1">Assign corrective / preventive action</h2>
<p class="text-muted">@Model.ReferenceNo — @Model.Title</p>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="HazardId" />
    <input type="hidden" asp-for="ReferenceNo" />
    <input type="hidden" asp-for="Title" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"
                      placeholder="What must be done to mitigate this hazard?"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<SMSHazard.Domain.Enums.CapaType>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="AssignedToId" class="form-label"></label>
            <select asp-for="AssignedToId" asp-items="Model.Owners" class="form-select">
                <option value="">— select owner —</option>
            </select>
            <span asp-validation-for="AssignedToId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DueDate" class="form-label"></label>
            <input asp-for="DueDate" type="date" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Assign action</button>
        <a class="btn btn-outline-secondary" asp-controller="Hazards" asp-action="Details" asp-route-id="@Model.HazardId">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
