@model SMSHazard.Web.Models.Capa.UpdateCapaViewModel
@{
    ViewData["Title"] = "Update action";
}
<h2 class="mb-1">Update action progress</h2>
<p class="text-muted">@Model.HazardRef — @Model.HazardTitle</p>

<div class="card mb-3"><div class="card-body">
    <h6 class="card-title">Action</h6>
    <p class="mb-0">@Model.Description</p>
</div></div>

<form asp-action="Update" method="post">
    <input type="hidden" asp-for="CapaId" />
    <input type="hidden" asp-for="HazardId" />
    <input type="hidden" asp-for="HazardRef" />
    <input type="hidden" asp-for="HazardTitle" />
    <input type="hidden" asp-for="Description" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="0">Open</option>
                <option value="1">In Progress</option>
                <option value="2">Completed</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="ProgressNote" class="form-label"></label>
            <textarea asp-for="ProgressNote" class="form-control" rows="3"></textarea>
            <span asp-validation-for="ProgressNote" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="MyActions">My actions</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
