@model SMSHazard.Web.Models.Capa.UpdateCapaViewModel
@{
    ViewData["Title"] = "Update action";
}
<h2 class="text-xl font-semibold text-slate-900">Update action progress</h2>
<p class="text-slate-500 mb-4">@Model.HazardRef — @Model.HazardTitle</p>

<div class="card mb-4 max-w-3xl"><div class="card-body">
    <h6 class="card-title">Action</h6>
    <p class="text-slate-700">@Model.Description</p>
</div></div>

<div class="card max-w-3xl"><div class="card-body">
    <partial name="_UpdateForm" model="Model" />
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
