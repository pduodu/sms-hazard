@model IReadOnlyList<SMSHazard.Application.DTOs.MyActionDto>
@{
    ViewData["Title"] = "My actions";
}
<h2 class="text-xl font-semibold text-slate-900 mb-4">My corrective actions</h2>
@if (!Model.Any())
{
    <div class="alert alert-muted">You have no assigned actions.</div>
}
else
{
    <div class="card"><div class="card-body overflow-x-auto">
    <table class="table table-hover">
        <thead><tr><th>Hazard</th><th>Action</th><th>Type</th><th>Due</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr class="@(a.IsOverdue ? "bg-red-50" : "")">
                <td class="whitespace-nowrap"><a asp-controller="Hazards" asp-action="Details" asp-route-id="@a.HazardId">@a.HazardRef</a></td>
                <td>@a.Description</td>
                <td>@a.Type</td>
                <td class="whitespace-nowrap">@a.DueDate.ToString("dd MMM yyyy") @(a.IsOverdue ? "⚠" : "")</td>
                <td>@a.Status</td>
                <td><a class="btn-outline-primary btn-sm" asp-action="Update" asp-route-id="@a.CapaId">Update</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div></div>
}
