@model SMSHazard.Web.Models.Users.CreateUserViewModel
@{
    ViewData["Title"] = "New user";
}
<h2 class="text-xl font-semibold text-slate-900 mb-4">New user</h2>
<div class="card max-w-lg"><div class="card-body">
<form asp-action="Create" method="post" class="space-y-4">
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div>
        <label asp-for="FullName" class="label"></label>
        <input asp-for="FullName" class="input" />
        <span asp-validation-for="FullName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Email" class="label"></label>
        <input asp-for="Email" class="input" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Role" class="label"></label>
        <select asp-for="Role" asp-items="Model.Roles" class="select"></select>
    </div>
    <div>
        <label asp-for="Password" class="label"></label>
        <input asp-for="Password" class="input" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn-primary">Create user</button>
        <a class="btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
