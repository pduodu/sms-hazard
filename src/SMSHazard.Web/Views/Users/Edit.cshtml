@model SMSHazard.Web.Models.Users.EditUserViewModel
@{
    ViewData["Title"] = "Edit user";
}
<h2 class="text-xl font-semibold text-slate-900 mb-4">Edit user</h2>
<div class="card max-w-lg"><div class="card-body">
<form asp-action="Edit" method="post" class="space-y-4">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div>
        <label class="label">Email</label>
        <input class="input bg-slate-50" value="@Model.Email" disabled />
    </div>
    <div>
        <label asp-for="FullName" class="label"></label>
        <input asp-for="FullName" class="input" />
        <span asp-validation-for="FullName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Role" class="label"></label>
        <select asp-for="Role" asp-items="Model.Roles" class="select"></select>
    </div>
    <div class="form-check">
        <input asp-for="IsActive" class="rounded border-slate-300 text-primary focus:ring-primary" />
        <label asp-for="IsActive" class="text-sm text-slate-700">Active (can sign in)</label>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn-primary">Save</button>
        <a class="btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
