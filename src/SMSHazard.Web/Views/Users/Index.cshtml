@model IReadOnlyList<SMSHazard.Web.Models.Users.UserRowViewModel>
@{
    ViewData["Title"] = "Users";
}
<div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-semibold text-slate-900">Users</h2>
    <a class="btn-primary" asp-action="Create">+ New user</a>
</div>
<div class="card"><div class="card-body overflow-x-auto">
<table class="table table-hover" data-datatable>
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>@u.Role</td>
            <td>@(u.IsActive ? Html.Raw("<span class='badge badge-green'>Active</span>") : Html.Raw("<span class='badge badge-gray'>Disabled</span>"))</td>
            <td class="whitespace-nowrap">
                <a class="btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                <a class="btn-outline btn-sm" asp-action="ResetPassword" asp-route-id="@u.Id">Reset password</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div></div>
