@model IReadOnlyList<SMSHazard.Web.Models.Users.UserRowViewModel>
@{
    ViewData["Title"] = "Users";
}
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Users</h2>
    <a class="btn btn-primary" asp-action="Create">+ New user</a>
</div>
<table class="table table-hover align-middle">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>@u.Role</td>
            <td>@(u.IsActive ? Html.Raw("<span class='badge bg-success'>Active</span>") : Html.Raw("<span class='badge bg-secondary'>Disabled</span>"))</td>
            <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
