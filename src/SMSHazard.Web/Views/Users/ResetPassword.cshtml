@model SMSHazard.Web.Models.Users.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<h2 class="text-xl font-semibold text-slate-900 mb-1">Reset password</h2>
<p class="text-slate-500 mb-4">@Model.FullName — @Model.Email</p>

<div class="card max-w-md"><div class="card-body">
<form asp-action="ResetPassword" method="post" class="space-y-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div>
        <label asp-for="NewPassword" class="label"></label>
        <input asp-for="NewPassword" class="input" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="label"></label>
        <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="btn-primary">Set new password</button>
        <a class="btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
